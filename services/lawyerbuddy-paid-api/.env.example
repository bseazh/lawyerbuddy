ALIPAY_ENV=production
PAYMENT_MODE=alipay_production
ALIPAY_APP_ID=填写正式AppID
ALIPAY_APP_PRIVATE_KEY_FILE=/absolute/path/to/app-private-key.txt
ALIPAY_PUBLIC_KEY_FILE=/absolute/path/to/alipay-public-key.txt
ALIPAY_SELLER_ID=填写正式商家PID
ALIPAY_SERVICE_ID=填写支付宝正式serviceId
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_UNIT_PRICE_CNY=0.01
# 可选；不填写时首次启动自动生成 data/license-signing-secret（0600）。
# LICENSE_SIGNING_SECRET_FILE=/etc/lawyerbuddy/secrets/license-signing-secret
LAWYERBUDDY_VERSION=1.9.1
PORT=3000

# 仅用于官方临时沙箱联调；不要与自己的 AppID/密钥混用。
# ALIPAY_CONFIG_SOURCE=sandbox_file
